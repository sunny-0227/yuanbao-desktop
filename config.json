{
  "app_name": "元宝桌面助手",
  "pet_name": "元宝",
  "log_level": "INFO",
  "ai": {
    "provider": "freellmapi",
    "api_key": "",
    "base_url": "",
    "model": "auto",
    "temperature": 0.7,
    "max_tokens": 1024,
    "system_prompt": "你是一个专注于日常办公、学习和资料处理的桌面AI效率助手，名叫元宝，形象是一只长毛金虎斑猫。请用简洁自然的中文回答问题，优先给出可操作的建议。",
    "enable_ai_cache": false
  },
  "ui": {
    "theme": "light",
    "font_size": 14,
    "window_width": 1000,
    "window_height": 740,
    "always_on_top": false,
    "pet_size": 120,
    "pet_opacity": 0.95,
    "pet_skin": "default",
    "pet_visible": true,
    "pet_x": -1,
    "pet_y": -1,
    "edge_collapse": true,
    "autostart": false
  },
  "behavior": {
    "idle_sleep_minutes": 5,
    "auto_sleep_enabled": true,
    "whitelist_processes": [],
    "cpu_sleep_threshold": 80,
    "blacklist_processes": []
  },
  "search": {
    "engine": "bing",
    "engines": {
      "bing": "https://www.bing.com/search?q=",
      "baidu": "https://www.baidu.com/s?wd=",
      "google": "https://www.google.com/search?q="
    }
  },
  "screenshot": {
    "save_dir": "%USERPROFILE%\\Pictures\\YuanbaoScreenshots",
    "format": "png",
    "auto_open": false
  },
  "voice": {
    "input_device": "",
    "wake_enabled": false,
    "wake_word": "元宝元宝",
    "wake_model_path": "",
    "asr_url": "",
    "asr_key": "",
    "asr_model": "whisper-1",
    "offline_model": "tiny",
    "voice_enabled": false,
    "asr_provider": "none",
    "tts_enabled": false,
    "tts_provider": "edge",
    "tts_voice": "zh-CN-XiaoxiaoNeural",
    "tts_max_chars": 200
  },
  "quick_apps": [
    {
      "name": "浏览器",
      "command": "",
      "_comment": "留空则使用系统默认浏览器"
    },
    {
      "name": "Edge",
      "command": "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe",
      "_comment": "Microsoft Edge 默认路径，如不符请修改"
    },
    {
      "name": "Chrome",
      "command": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe",
      "_comment": "Google Chrome 默认路径，如不符请修改"
    },
    {
      "name": "微信",
      "command": "%USERPROFILE%\\AppData\\Roaming\\Tencent\\WeChat\\WeChat.exe",
      "_comment": "微信默认安装路径，如不符请修改"
    },
    {
      "name": "Word",
      "command": "WINWORD.EXE",
      "_comment": "Office 已加入 PATH 时可直接使用命令名；否则填写完整路径"
    },
    {
      "name": "Excel",
      "command": "EXCEL.EXE",
      "_comment": "同 Word"
    },
    {
      "name": "PowerPoint",
      "command": "POWERPNT.EXE",
      "_comment": "同 Word"
    },
    {
      "name": "计算器",
      "command": "calc.exe",
      "_comment": "Windows 内置计算器"
    },
    {
      "name": "记事本",
      "command": "notepad.exe",
      "_comment": "Windows 内置记事本"
    },
    {
      "name": "Cursor",
      "command": "%LOCALAPPDATA%\\Programs\\cursor\\Cursor.exe",
      "_comment": "Cursor IDE 默认安装路径，如不符请修改"
    },
    {
      "name": "VS Code",
      "command": "%LOCALAPPDATA%\\Programs\\Microsoft VS Code\\Code.exe",
      "_comment": "VS Code 默认安装路径"
    }
  ],
  "quick_folders": [
    {
      "name": "桌面",
      "path": "%USERPROFILE%\\Desktop"
    },
    {
      "name": "下载",
      "path": "%USERPROFILE%\\Downloads"
    },
    {
      "name": "下载目录",
      "path": "%USERPROFILE%\\Downloads"
    },
    {
      "name": "文档",
      "path": "%USERPROFILE%\\Documents"
    },
    {
      "name": "图片",
      "path": "%USERPROFILE%\\Pictures"
    },
    {
      "name": "项目",
      "path": "%USERPROFILE%\\Projects",
      "_comment": "请修改为你的实际项目目录"
    },
    {
      "name": "截图",
      "path": "%USERPROFILE%\\Pictures\\YuanbaoScreenshots",
      "_comment": "与 screenshot.save_dir 保持一致"
    },
    {
      "name": "截图目录",
      "path": "%USERPROFILE%\\Pictures\\YuanbaoScreenshots"
    }
  ],
  "ai_endpoints": [],
  "offline_ai_url": "",
  "offline_ai_model": ""
}
