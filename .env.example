# 环境变量配置示例
# 复制此文件为 .env 并填入实际值
# 注意：.env 文件不要提交到 Git！

# ── AI 服务配置 ──────────────────────────────────────
# OpenAI API Key（从 platform.openai.com 获取）
AI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 自定义 API 地址（使用 DeepSeek 等兼容服务时填写）
# OpenAI 官方接口无需填写
# AI_BASE_URL=https://api.deepseek.com/v1

# 模型名称（覆盖 config.json 中的设置）
# AI_MODEL=deepseek-chat
